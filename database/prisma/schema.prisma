generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
  SUPER_ADMIN
  BILLING_MANAGER
}

// RBAC Models
model RbacRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RbacRolePermission[]
  userTenants UserTenant[]

  @@map("rbac_roles")
}

model RbacPermission {
  id          String   @id @default(uuid())
  name        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RbacRolePermission[]

  @@map("rbac_permissions")
}

model RbacRolePermission {
  roleId       String
  role         RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("rbac_role_permissions")
}

// Multi-tenant Models
model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  settings  Json?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTenants UserTenant[]
  conversations Conversation[]

  @@map("tenants")
}

model UserTenant {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String
  role      RbacRole @relation(fields: [roleId], references: [id])
  joinedAt  DateTime @default(now())

  @@id([userId, tenantId])
  @@map("user_tenants")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
  PENDING
  OPEN
}

enum AlertType {
  POD_CRASH
  POD_RESTART
  HIGH_CPU
  HIGH_MEMORY
  DEPLOYMENT_FAILED
  POD_PENDING
  IMAGE_PULL_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  avatar             String?
  emailVerified      Boolean  @default(false)
  emailVerifyTokenHash String?  @unique
  emailVerifyExpires   DateTime?
  phone              String?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean  @default(false)
  recoveryCodes      String[] @default([])
  webhookUrl         String?
  githubId           String?  @unique
  googleId           String?  @unique
  cloudPlanId        String?
  cloudPlan          CloudPlan? @relation(fields: [cloudPlanId], references: [id])
  trialEndsAt        DateTime?
  subscriptionStatus CloudSubscriptionStatus @default(TRIALING)
  overrideLimits     Json?
  notificationPrefs  Json?
  suspendedAt        DateTime?
  suspendedReason    String?
  lastLoginAt        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations   Conversation[]
  messages        Message[]
  whatsappContacts WhatsappContact[]
  documents       Document[]
  documentVersions DocumentVersion[] @relation("DocumentVersionAuthor")
  documentCollaborators DocumentCollaborator[]
  
  // CRM relations
  crmLeads       CrmLead[]
  crmContacts    CrmContact[]
  crmCompanies   CrmCompany[]
  crmDeals       CrmDeal[]
  crmTasks       CrmTask[]
  crmActivities  CrmActivity[]
  
  // Learning & Career relations
  savedJobs           SavedJob[]
  pathEnrollments     PathEnrollment[]
  certificationTrackers CertificationTracker[]
  cvs                 CV[]
  bookTrackers        BookTracker[]
  conferenceInterests ConferenceInterest[]
  blogPosts           BlogPost[]
  
  // Automation relations
  scripts             Script[]
  workflowTemplates   WorkflowTemplate[]
  
  // Collaboration relations
  channels            Channel[]
  knowledgeArticles   KnowledgeArticle[]
  codeReviews         CodeReview[]
  calendarEvents      CalendarEvent[]
  
  // Integrations relations
  webhooks            Webhook[]

  // Platform relations
  projects            Project[]
  apiKeys             ApiKey[]
  appSecrets          AppSecret[]
  auditLogs           AuditLog[]
  adminAuditLogs      AuditLog[] @relation("AdminAuditActions")
  notes               Note[]

  // RBAC & Multi-tenant relations
  userTenants         UserTenant[]
  notifications       Notification[]


  // Cloud (HaaS) relations
  cloudDeployments    CloudDeployment[]
  cloudInvoices       CloudInvoice[]
  cloudPaymentMethods CloudPaymentMethod[]
  vpsAlertRules       VpsAlertRule[] @relation("UserVpsAlertRules")
  sshKeys             SSHKey[]
  firewallRules       FirewallRule[]
  ownedOrganizations  Organization[]            @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  customImages        CustomImage[]
  customImageShares   CustomImageShare[]
  domains             Domain[]
  apiRateLimits       APIRateLimit[]
  webhookEndpoints    WebhookEndpoint[]
  vpsSnapshots        VPSSnapshot[]
  referralsMade       Referral[] @relation("Referrals")
  referredBy          Referral?  @relation("Referred")
  referralPayoutMethod Json?


  // Password reset
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?           @relation(fields: [tenantId], references: [id])
  platform    String
  contactId   String?
  platformId  String?
  title       String?
  status      ConversationStatus @default(OPEN)
  assignedTo  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  messages Message[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  category  String?
  link      String?
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  channelId      String?
  channel        Channel?    @relation(fields: [channelId], references: [id])
  role           String
  content        String
  type           MessageType @default(TEXT)
  mediaUrl       String?
  waMessageId    String?
  direction      String     @default("OUTBOUND")
  createdAt      DateTime   @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model WhatsappContact {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  waId         String           @unique
  name         String?
  phone        String?
  profilePic   String?
  isBlocked    Boolean          @default(false)
  crmContactId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages     WhatsappMessage[]

  @@index([userId])
  @@index([crmContactId])
}

model WhatsappMessage {
  id             String   @id @default(uuid())
  contactId      String
  contact        WhatsappContact @relation(fields: [contactId], references: [id])
  waMessageId    String   @unique
  direction      String   // inbound, outbound
  content        String   @db.Text
  type           String   @default("text") // text, image, audio, video, document
  mediaUrl       String?
  status         String   @default("sent") // sent, delivered, read, failed
  timestamp      DateTime
  createdAt      DateTime @default(now())

  @@index([contactId])
  @@index([direction])
  @@index([timestamp])
}

// WhatsApp CRM Models
model CrmLead {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  phone       String?
  source      String   @default("whatsapp") // whatsapp, manual, referral
  status      String   @default("new") // new, contacted, qualified, lost, converted
  value       Float?
  currency    String   @default("USD")
  notes       String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       CrmDeal[]
  activities  CrmActivity[]

  @@index([userId])
  @@index([status])
}

model CrmContact {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  company     String?
  title       String?
  notes       String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CrmCompany {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  industry    String?
  size        String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CrmDeal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        CrmLead?  @relation(fields: [leadId], references: [id])
  title       String
  value       Float
  currency    String   @default("USD")
  stage       String   @default("prospecting") // prospecting, qualification, proposal, negotiation, closed_won, closed_lost
  probability Int      @default(0)
  expectedCloseDate DateTime?
  actualCloseDate    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([stage])
}

model CrmTask {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("medium") // low, medium, high
  status      String   @default("todo") // todo, in_progress, done, cancelled
  relatedTo   String?  // lead, deal, contact
  relatedId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model CrmActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        CrmLead?  @relation(fields: [leadId], references: [id])
  type        String   // call, email, meeting, note, whatsapp_message
  subject     String?
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([leadId])
  @@index([createdAt])
}

model WebhookLog {
  id        String   @id @default(uuid())
  platform  String
  eventType String
  source    String?
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AlertRule {
  id            String         @id @default(uuid())
  name          String
  description   String?
  type          AlertType
  enabled       Boolean        @default(true)
  severity      AlertSeverity  @default(WARNING)
  
  // Rule conditions
  namespace     String?        // Optional: filter by namespace
  labelSelector String?        // Optional: filter by labels
  threshold     Float?         // For CPU/Memory alerts
  duration      Int?           // Duration in seconds before triggering
  
  // Notification settings
  notifyEmail   Boolean        @default(false)
  notifySlack   Boolean        @default(false)
  webhookUrl    String?        // For custom webhook notifications
  
  // Relationships
  alerts        Alert[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Alert {
  id            String         @id @default(uuid())
  ruleId        String
  rule          AlertRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  // Alert details
  type          AlertType
  severity      AlertSeverity
  namespace     String
  resourceName  String         // Pod name, deployment name, etc.
  resourceType  String         // Pod, Deployment, Service, etc.
  
  // Status
  status        String         @default("FIRING")  // FIRING, RESOLVED
  message       String
  details       Json?          // Additional details in JSON format
  
  // Timeline
  firedAt       DateTime       @default(now())
  resolvedAt    DateTime?
  acknowledgedAt DateTime?
  
  // Tracking
  notificationSent Boolean      @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DeploymentHistory {
  id           String   @id @default(uuid())
  provider     String
  owner        String?
  repo         String
  workflowId   String?
  ref          String?
  status       String   @default("PENDING")
  initiatedBy  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  logsUrl      String?
  details      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Documentation models
model Document {
  id          String              @id @default(uuid())
  title       String
  content     String              @db.Text
  categoryId  String?
  category    DocumentCategory?   @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User                @relation(fields: [authorId], references: [id])
  fileType    String?
  fileName    String?
  fileSize    Int?
  isRunbook   Boolean             @default(false)
  incidentId  String?
  tags        DocumentTag[]
  collaborators DocumentCollaborator[]
  versions    DocumentVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model DocumentCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  documents   Document[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model DocumentTag {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]
  createdAt DateTime   @default(now())
}

model DocumentVersion {
  id                  String   @id @default(uuid())
  documentId          String
  document            Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content             String   @db.Text
  versionNumber       Int
  createdBy           String
  createdByUser       User     @relation("DocumentVersionAuthor", fields: [createdBy], references: [id])
  isRestore           Boolean  @default(false)
  restoredFromVersionId String?
  createdAt           DateTime @default(now())
}

model DocumentCollaborator {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  permission String   @default("read") // read, write, admin
  addedAt    DateTime @default(now())
}

// Learning & Career models
model SavedJob {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  savedAt   DateTime @default(now())
  
  @@unique([jobId, userId])
}

model LearningPath {
  id          String           @id @default(uuid())
  title       String
  description String
  category    String
  difficulty  String
  duration    Int              // in hours
  modules     LearningModule[]
  enrollments PathEnrollment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model LearningModule {
  id          String            @id @default(uuid())
  pathId      String
  path        LearningPath      @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int
  resources   LearningResource[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model LearningResource {
  id          String         @id @default(uuid())
  moduleId    String
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  type        String         // video, article, exercise, quiz
  url         String?
  content     String?
  duration    Int?
  createdAt   DateTime       @default(now())
}

model PathEnrollment {
  id        String       @id @default(uuid())
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  status    String       @default("not_started") // not_started, in_progress, completed
  enrolledAt DateTime     @default(now())
  completedAt DateTime?
  progress  PathProgress[]
  
  @@unique([userId, pathId])
}

model PathProgress {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   PathEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  completed    Boolean       @default(false)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
}

model Certification {
  id          String                @id @default(uuid())
  title       String
  provider    String                // AWS, Azure, Google, CNCF, etc.
  category    String                // cloud, devops, security, etc.
  level       String                // associate, professional, expert, etc.
  description String
  duration    Int                   // in hours
  cost        Float?
  url         String?
  trackers    CertificationTracker[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CertificationTracker {
  id              String         @id @default(uuid())
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id])
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  status          String         @default("not_started") // not_started, in_progress, completed, expired
  targetDate      DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@unique([userId, certificationId])
}

model CV {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  title       String
  templateId  String?
  content     String     @db.Text
  fileType    String     // latex, markdown
  fileName    String?
  atsScore    Int?
  sections    CVSection[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CVSection {
  id        String   @id @default(uuid())
  cvId      String
  cv        CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CVTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String   // devops, sre, cloud, academic, etc.
  description String
  content     String   @db.Text
  preview     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conference {
  id          String               @id @default(uuid())
  name        String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  year        Int
  url         String?
  interests   ConferenceInterest[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ConferenceInterest {
  id            String      @id @default(uuid())
  conferenceId  String
  conference    Conference  @relation(fields: [conferenceId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  registeredAt  DateTime    @default(now())
  
  @@unique([userId, conferenceId])
}

model Book {
  id          String       @id @default(uuid())
  title       String
  author      String
  isbn        String?
  category    String
  description String
  coverUrl    String?
  amazonUrl   String?
  trackers    BookTracker[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BookTracker {
  id         String   @id @default(uuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  status     String   @default("to_read") // to_read, reading, completed
  rating     Int?
  review     String?
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, bookId])
}

model Script {
  id          String   @id @default(uuid())
  name        String
  description String
  language    String   // python, bash, javascript, etc.
  content     String   @db.Text
  category    String
  tags        String[]
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  steps       Json     // Array of workflow steps
  parameters  Json     // Workflow parameters
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  messages    Message[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  category    String
  tags        String[]
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CodeReview {
  id             String   @id @default(uuid())
  title          String
  description    String
  repository     String
  pullRequestUrl String
  status         String   @default("pending") // pending, in_review, approved, rejected
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String
  attendees   String[]
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  method    String   @default("POST")
  headers   Json?
  events    String[]
  active    Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  category    String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  repository  String?
  namespace   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String
  keyPrefix  String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  rateLimits APIRateLimit[]
}

model AppSecret {
  id             String    @id @default(uuid())
  name           String
  namespace      String    @default("default")
  encryptedValue String
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, name, namespace])
}

model ClusterConfig {
  id             String   @id @default(uuid())
  name           String
  context        String
  environment    String   @default("production")
  isDefault      Boolean  @default(false)
  kubeconfigPath String?
  apiServer      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  adminId   String?
  admin     User?    @relation("AdminAuditActions", fields: [adminId], references: [id])
  userEmail String?
  resource  String?
  details   Json?
  ipAddress String?
  userAgent String?
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([adminId])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  tags      String?
  pinned    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ============================================================
// AmerCloud — Hosting as a Service (HaaS)
// ============================================================

enum CloudSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
}

enum CloudDeploymentStatus {
  PENDING
  PENDING_PAYMENT
  PROVISIONING
  DEPLOYING
  RUNNING
  STOPPED
  SUSPENDED
  FAILED
  DELETED
  TERMINATED
}

enum CloudDeploymentType {
  GITHUB
  DOCKER_IMAGE
  DOCKER_COMPOSE
}

enum CloudInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CloudPaymentMethodType {
  CREDIT_CARD
  FAWRY
  INSTAPAY
  VODAFONE_CASH
  CASH
}

model CloudPlan {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  description        String?
  priceUSD           Float    @default(0)
  priceEGP           Float    @default(0)
  interval           String   @default("monthly")
  cpuLimit           Float    @default(0.25)
  memoryLimit        Int      @default(512)
  storageLimit       Int      @default(1024)
  deploymentLimit    Int      @default(1)
  vpsLimit           Int      @default(1)
  customDomainLimit  Int      @default(0)
  apiRequestLimit    Int      @default(10000)
  teamMemberLimit    Int      @default(1)
  databaseSizeLimit  Int      @default(0)
  redisLimit         Int?
  trialDays          Int      @default(0)
  features           Json
  isActive           Boolean  @default(true)
  isPopular          Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]
}

model CloudDeployment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  status        CloudDeploymentStatus @default(PENDING)
  statusMessage String?
  type          CloudDeploymentType   @default(DOCKER_IMAGE)
  source        String
  namespace     String   @unique
  subdomain     String?  @unique
  cpu           Float    @default(0.25)
  memory        Int      @default(512)
  storage       Int      @default(1024)
  replicas      Int      @default(1)
  customDomains String[]
  envVars       Json?
  healthCheck   String?
  webhookUrl    String?
  // VPS-specific fields (stubbed Proxmox provisioning)
  hostname         String?
  ipv4Address      String?
  rootPasswordHash String?
  proxmoxVMID      Int?
  proxmoxNode      String?
  provisionedAt    DateTime?
  suspendedAt      DateTime?
  terminatedAt     DateTime?
  lastDeployedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  backups       CloudBackup[]
  backupSchedule BackupSchedule?
  security      VpsSecuritySettings?
  vpsAlertRules         VpsAlertRule[]
  vpsAlertNotifications VpsAlertNotification[]
  sshKeys       SSHKey[] @relation("VPSKeys")
  firewallRules FirewallRule[]
  snapshots     CustomImage[]
  vpsSnapshots  VPSSnapshot[]
  domains       Domain[]
  usageMetrics  UsageMetric[]
  migrations    VPSMigration[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  apps          String[]      @default([])
  installedApps Json?
  controlPanel              String?
  controlPanelStatus        String?
  controlPanelUrl           String?
  controlPanelUser          String?
  controlPanelPassword      String?
  controlPanelInstalledAt   DateTime?

  @@index([userId, status])
}

model VPSSnapshot {
  id                  String    @id @default(uuid())
  vpsId               String
  vps                 CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  sizeBytes           BigInt    @default(0)
  status              String    @default("CREATING")
  proxmoxSnapshotName String?
  errorMessage        String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([vpsId])
  @@index([userId])
}

enum VpsAlertType {
  CPU
  RAM
  DISK
  BANDWIDTH
  UPTIME
}

enum VpsAlertOperator {
  GREATER_THAN
  LESS_THAN
  EQUALS
}

model VpsAlertRule {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserVpsAlertRules", fields: [userId], references: [id], onDelete: Cascade)
  vpsId           String?
  vps             CloudDeployment? @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  name            String
  type            VpsAlertType
  operator        VpsAlertOperator
  threshold       Float
  duration        Int?
  cooldown        Int      @default(30)
  enabled         Boolean  @default(true)
  lastTriggeredAt DateTime?
  notifications   VpsAlertNotification[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([vpsId])
  @@index([enabled])
}

model VpsAlertNotification {
  id          String   @id @default(uuid())
  alertRuleId String
  alertRule   VpsAlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  vpsId       String
  vps         CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  status      String   @default("TRIGGERED")
  message     String
  value       Float
  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?

  @@index([alertRuleId])
  @@index([vpsId])
  @@index([triggeredAt])
}


enum BackupType {
  MANUAL
  SCHEDULED
}

model CloudBackup {
  id           String   @id @default(uuid())
  deploymentId String
  deployment   CloudDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  userId       String?
  name         String?
  type         BackupType @default(MANUAL)
  sizeMB       Int       @default(0)
  storagePath  String
  sizeBytes    BigInt?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([deploymentId])
  @@index([userId])
}

model BackupSchedule {
  id          String   @id @default(cuid())
  vpsId       String   @unique
  vps         CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  frequency   String   @default("DAILY")
  retention   Int      @default(7)
  hour        Int?
  dayOfWeek   Int?
  dayOfMonth  Int?
  offsiteProvider  String?
  offsiteBucket    String?
  offsiteAccessKey String?
  offsiteSecretKey String?
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VpsSecuritySettings {
  id             String   @id @default(cuid())
  vpsId          String   @unique
  vps            CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  wafEnabled     Boolean  @default(false)
  wafPreset      String   @default("OWASP")
  wafCustomRules Json?
  ddosTier       String   @default("BASIC")
  fimEnabled     Boolean  @default(false)
  fimPaths       String[] @default(["/etc","/var/www","/usr/bin"])
  updatedAt      DateTime @updatedAt @default(now())
}

model CloudAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  targetId  String?
  action    String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
}

model CloudInvoice {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number      String   @unique
  amountUSD   Float?
  amountEGP   Float?
  currency    String   @default("USD")
  status      CloudInvoiceStatus @default(PENDING)
  description String
  provider    String?
  providerRef String?
  dueDate     DateTime
  paidAt      DateTime?
  refundedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, status])
}

model CloudPaymentMethod {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       CloudPaymentMethodType
  providerId String
  label      String?
  last4      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model CloudAnnouncement {
  id        String   @id @default(uuid())
  title     String
  body      String   @db.Text
  severity  String   @default("info")
  audience  String   @default("all")
  createdAt DateTime @default(now())
}

model FirewallRule {
  id          String   @id @default(cuid())
  vpsId       String
  vps         CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  priority    Int      @default(100)
  action      String
  protocol    String
  port        String?
  sourceIP    String?
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vpsId])
  @@index([priority])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id])
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  vps         CloudDeployment[]
  invitations OrganizationInvitation[]

  @@index([slug])
}

model OrganizationMember {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(MEMBER)
  invitedBy      String
  invitedAt      DateTime     @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  @@unique([organizationId, email])
  @@index([email])
}

model Domain {
  id           String    @id @default(cuid())
  vpsId        String
  vps          CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String    @unique
  autoSSL      Boolean   @default(false)
  sslIssuedAt  DateTime?
  sslExpiresAt DateTime?
  verifiedAt   DateTime?
  verifyToken  String
  createdAt    DateTime  @default(now())

  dnsRecords   DNSRecord[]

  @@index([vpsId])
  @@index([domain])
}

model DNSRecord {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      String
  name      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())

  @@index([domainId])
}

model UsageMetric {
  id         String   @id @default(cuid())
  userId     String
  vpsId      String
  vps        CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  metricType String
  value      Float
  unit       String
  recordedAt DateTime @default(now())

  @@index([userId])
  @@index([vpsId])
  @@index([recordedAt])
}

model APIRateLimit {
  id        String   @id @default(cuid())
  apiKeyId  String?
  apiKey    ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  method    String
  period    String
  limit     Int
  remaining Int
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  events    String[]
  secret    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  webhookId      String
  webhook        WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempt        Int             @default(1)
  success        Boolean         @default(false)
  error          String?
  createdAt      DateTime        @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

model VPSMigration {
  id              String   @id @default(cuid())
  vpsId           String
  vps             CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId          String
  sourceNode      String
  targetNode      String
  sourceStorage   String?
  targetStorage   String?
  status          String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED, SCHEDULED
  progress        Int      @default(0)
  estimatedDowntimeSec Int @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  proxmoxTaskId   String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([vpsId])
  @@index([userId])
  @@index([status])
}

model Referral {
  id           String            @id @default(cuid())
  referrerId   String
  referrer     User              @relation("Referrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String            @unique
  referred     User              @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  code         String
  status       String            @default("PENDING")
  convertedAt  DateTime?
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  earnings     ReferralEarning[]

  @@index([referrerId])
  @@index([code])
}

model ReferralEarning {
  id          String    @id @default(cuid())
  referralId  String
  referral    Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String    @default("USD")
  description String
  status      String    @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([referralId])
  @@index([status])
}

model ReferralPayoutRequest {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  currency    String    @default("USD")
  method      String
  destination String
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([userId])
  @@index([status])
}

model SSHKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  publicKey   String    @unique
  fingerprint String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  vpses       CloudDeployment[] @relation("VPSKeys")

  @@index([userId])
}

model CustomImage {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  name        String
  description String?
  type        String      // SNAPSHOT, CUSTOM, MARKETPLACE
  sourceVpsId String?
  sourceVps   CloudDeployment? @relation(fields: [sourceVpsId], references: [id])
  sizeMB      Int
  isPublic    Boolean     @default(false)
  storageUrl  String
  createdAt   DateTime    @default(now())

  shares      CustomImageShare[]

  @@index([userId])
  @@index([isPublic])
}

model CustomImageShare {
  id          String      @id @default(cuid())
  imageId     String
  image       CustomImage @relation(fields: [imageId], references: [id])
  sharedWithEmail String
  sharedBy    String
  sharedAt    DateTime    @default(now())

  // Opposite relation to User model
  user        User        @relation(fields: [sharedBy], references: [id])

  @@unique([imageId, sharedWithEmail])
}

model Maintenance {
  id               String   @id @default(cuid())
  title            String
  description      String
  affectedServices String[] // VPS, API, Dashboard, Billing
  startAt          DateTime
  endAt            DateTime
  status           String   // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([startAt])
  @@index([status])
}

// ─── Platform Enhancement Models ─────────────────────────────

/// Proxmox cluster registry — one row per Proxmox host
/// Table name: proxmox_clusters (@@map); columns use Prisma's default camelCase.
///
/// SECURITY: tokenSecret is a sensitive API credential. The application layer
/// MUST AES-256-GCM-encrypt the value (using a key derived from SESSION_SECRET)
/// before writing to this field, and decrypt after reading. Never store plaintext.
/// When tokenSecret is present, store the format: "<iv_hex>:<authTag_hex>:<ciphertext_hex>".
model ProxmoxCluster {
  id          String   @id @default(uuid())
  name        String
  host        String
  port        Int      @default(8006)
  username    String   @default("root@pam")
  tokenId     String?
  /// Encrypted at application layer — AES-256-GCM. See schema doc above.
  tokenSecret String?
  status      String   @default("ACTIVE")
  cpuTotal    Int      @default(0)
  ramTotal    BigInt   @default(0)
  diskTotal   BigInt   @default(0)
  cpuUsed     Int      @default(0)
  ramUsed     BigInt   @default(0)
  diskUsed    BigInt   @default(0)
  vmCount     Int      @default(0)
  nodeCount   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("proxmox_clusters")
}


/// Timestamped health check snapshots for each microservice
model ServiceHealthLog {
  id               String   @id @default(uuid())
  serviceName      String
  status           String   // UP | DEGRADED | DOWN
  responseTimeMs   Int?
  errorMessage     String?
  uptimePercentage Float    @default(100)
  checkedAt        DateTime @default(now())

  @@index([serviceName])
  @@index([checkedAt])
  @@index([status])
  @@map("service_health_logs")
}

/// WhatsApp broadcast campaign records
model WhatsappBroadcast {
  id             String    @id @default(uuid())
  createdBy      String
  tenantId       String?
  templateId     String?
  templateName   String?
  messageBody    String    @db.Text
  segment        String    @default("all")
  status         String    @default("PENDING") // PENDING | SENDING | COMPLETED | FAILED
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)
  metadata       Json?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_broadcasts")
}

/// Simple key-value platform configuration store
model PlatformSetting {
  key         String   @id
  value       String   @default("")
  valueType   String   @default("string") // string | boolean | number | json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt @default(now())

  @@map("platform_settings")
}

/// IP-based block list for rate-limit abuse prevention
model IpBlockList {
  id          String    @id @default(uuid())
  ipAddress   String    @unique
  reason      String?
  blockedBy   String?
  tenantId    String?
  isPermanent Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([ipAddress])
  @@index([createdAt])
  @@map("ip_block_list")
}

model Incident {
  id          String           @id @default(cuid())
  title       String
  description String
  severity    String           // DEGRADED, PARTIAL_OUTAGE, MAJOR_OUTAGE
  status      String           // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED
  updates     IncidentUpdate[]
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  message    String
  status     String
  createdAt  DateTime @default(now())

  @@index([incidentId])
}
