enum ManagedServiceStatus {
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
  DELETED
}

enum ManagedDatabaseEngine {
  POSTGRES
  MYSQL
  REDIS
  MONGODB
}

model ManagedDatabase {
  id             String                @id @default(uuid())
  userId         String
  organizationId String?
  name           String
  engine         ManagedDatabaseEngine
  version        String
  planCode       String
  cpuCores       Int                   @default(1)
  memoryMb       Int                   @default(1024)
  storageGb      Int                   @default(10)
  status         ManagedServiceStatus  @default(PROVISIONING)
  host           String?
  port           Int?
  databaseName   String?
  username       String?
  passwordCipher String?
  nodeName       String?
  clusterId      String?
  proxmoxVmid    Int?
  backupsEnabled Boolean               @default(true)
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  /// Idempotent provisioning (see ManagedDatabaseProvisionerService.provision):
  /// a worker claims the row by stamping this; a claim older than the lease TTL
  /// is treated as a crashed worker and may be re-claimed.
  provisionLockedAt DateTime?
  /// Monotonic counter of provisioning attempts, for observability/backoff.
  provisionAttempts Int      @default(0)
  /// Set once the LXC exists, so a retry reconciles instead of re-creating.
  provisionedAt     DateTime?
  /// Earliest time a retry may re-claim the row (exponential backoff).
  nextRetryAt       DateTime?
  /// Correlation/trace id of the most recent provisioning attempt. The same id
  /// is stamped on every timeline event and on every structured proxmox.api log
  /// line emitted during that attempt, so a failed event links to the exact HTTP call.
  correlationId     String?

  backups ManagedDatabaseBackup[]
  events  ManagedDatabaseEvent[]

  @@unique([userId, name])
  @@index([status])
  @@index([organizationId])
  @@index([status, provisionLockedAt])
  @@map("managed_databases")
}

/// Append-only provisioning timeline for a managed database. The tenant UI
/// streams these rows to show PROVISIONING -> RUNNING/FAILED transitions with
/// the exact errorMessage that was persisted on the parent row.
model ManagedDatabaseEvent {
  id         String               @id @default(uuid())
  databaseId String
  database   ManagedDatabase      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  status     ManagedServiceStatus
  /// Short human-readable step label, e.g. "Creating LXC container".
  step       String
  /// Failure detail copied from the provisioning error, when the step failed.
  message    String?
  /// Non-sensitive structured detail (vmid, node, endpoint, durationMs).
  detail     Json?
  /// Trace id shared with the structured proxmox.api log lines of the attempt.
  correlationId String?
  createdAt  DateTime             @default(now())

  @@index([databaseId, createdAt])
  @@index([correlationId])

  @@map("managed_database_events")
}

model ManagedDatabaseBackup {
  id          String          @id @default(uuid())
  databaseId  String
  database    ManagedDatabase @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  sizeBytes   BigInt          @default(0)
  status      String          @default("PENDING")
