// ============================================================
// Abuse handling / AUP (Prompt 0.17)
// ============================================================

enum AbuseCategory {
  SPAM
  MALWARE
  PHISHING
  DDOS
  CRYPTO_MINING
  COPYRIGHT
  OTHER
}

enum AbuseReportStatus {
  RECEIVED
  INVESTIGATING
  ACTION_TAKEN
  RESOLVED
  DISMISSED
}

enum PtrRequestStatus {
  REQUESTED
  FULFILLED
  REJECTED
}

model AbuseReport {
  id                String            @id @default(uuid())
  // Reporter identity (optional — third parties report anonymously)
  reporterName      String?
  reporterEmail     String?
  reporterIp        String?
  // Target of the report
  targetIp          String?
  targetDomain      String?
  targetVpsId       String?
  vps               CloudDeployment?  @relation(fields: [targetVpsId], references: [id], onDelete: SetNull)
  category          AbuseCategory     @default(OTHER)
  reason            String
  evidence          String?
  status            AbuseReportStatus @default(RECEIVED)
  // Filled when an automated detection (not a human report) generates the row
  source            String            @default("external") // external | automated
  detectedSignature String? // e.g. "mass_outbound_smtp", "sustained_cpu_mining"
  details           Json?
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([targetVpsId])
  @@index([category])
  @@index([createdAt])
}

model PtrRecordRequest {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsId       String
  vps         CloudDeployment  @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  ipAddress   String?
  hostname    String // requested PTR / reverse DNS hostname
  status      PtrRequestStatus @default(REQUESTED)
  adminNote   String?
  fulfilledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([vpsId])
}

// ============================================================
// Async VPS provisioning (Prompt 2.1) — job queue bookkeeping
// ============================================================

enum VpsProvisionJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model VpsProvisionJob {
  id             String                @id @default(uuid())
  // Client-generated idempotency key (UUID). Re-submits with the same key
  // return the existing job instead of double-provisioning.
  idempotencyKey String                @unique
  userId         String
  status         VpsProvisionJobStatus @default(QUEUED)
  // Serialized CreateVpsDto the worker replays when it picks up the job.
  payload        Json
  // Provisioning result (CloudDeployment id/ip/vmid) or error detail.
  result         Json?
  errorMessage   String?
  // CloudDeployment row created on success (null until then).
  vpsId          String?
  vps            CloudDeployment?      @relation(fields: [vpsId], references: [id], onDelete: SetNull)
  attempts       Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
}

model VPSSnapshot {
  id                  String          @id @default(uuid())
