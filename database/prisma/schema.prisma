// ============================================================
// Prompt 2.2a: Two-track billing (PAYG credits vs Subscription)
// Currency/FX policy: Points-per-dollar rate is locked at purchase time.
// When a tenant buys credits in any currency, the points granted are
// calculated once at purchase and never relitigated later regardless of FX movement.
// Example: "$25 → 300 points" or "1250 EGP → 300 points" at time of purchase,
// both locked permanently into this transaction's `amount` field.
// ============================================================

model CreditTransaction {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CreditTransactionType
  amount       Float // Points added (TOPUP/REFUND) or deducted (CONSUMPTION/ADJUSTMENT)
  balanceAfter Float // Snapshot of user's creditBalance immediately after this txn
  relatedVpsId String?
  relatedVps   CloudDeployment?      @relation(fields: [relatedVpsId], references: [id], onDelete: SetNull)
  reason       String? // Required for ADJUSTMENT; optional for others (e.g. "Support goodwill")
  metadata     Json? // Invoice ID, payment gateway ref, consumption period, etc.
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@index([relatedVpsId])
  @@map("credit_transactions")
}

