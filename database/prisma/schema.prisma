// ─── Platform Enhancement Models ─────────────────────────────

/// Proxmox cluster registry — one row per Proxmox host
/// Table name: proxmox_clusters (@@map); columns use Prisma's default camelCase.
///
/// SECURITY: tokenSecret is a sensitive API credential. The application layer
/// MUST AES-256-GCM-encrypt the value (using a key derived from SESSION_SECRET)
/// before writing to this field, and decrypt after reading. Never store plaintext.
/// When tokenSecret is present, store the format: "<iv_hex>:<authTag_hex>:<ciphertext_hex>".
model ProxmoxCluster {
  id               String   @id @default(uuid())
  name             String
  host             String
  port             Int      @default(8006)
  username         String   @default("root@pam")
  tokenId          String?
  /// Encrypted at application layer — AES-256-GCM. See schema doc above.
  tokenSecret      String?
  status           String   @default("ACTIVE") // ACTIVE | DISABLED | UNREACHABLE | MISCONFIGURED
  /// Classification of last connection failure (null when healthy).
  /// AUTH | TIMEOUT | NETWORK | MALFORMED | UNKNOWN
  lastErrorType    String?
  lastErrorMessage String?
  cpuTotal         Int      @default(0)
  ramTotal         BigInt   @default(0)
  diskTotal        BigInt   @default(0)
  cpuUsed          Int      @default(0)
  ramUsed          BigInt   @default(0)
  diskUsed         BigInt   @default(0)
  vmCount          Int      @default(0)
  nodeCount        Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pendingAllocations PendingAllocation[]
  deployments        CloudDeployment[]

  @@index([status])
  @@map("proxmox_clusters")
}

/// Reservation of cluster capacity while a VPS is being provisioned.
/// The scheduler creates a PENDING row inside the same transaction that reads
/// current free capacity, so concurrent scheduling requests see the reservation
/// and cannot double-allocate. On successful provisioning the row is marked
/// COMMITTED (and free capacity is instead accounted for by the real VM row).
/// On failure or TTL expiry the row is RELEASED and its capacity returns to the pool.
model PendingAllocation {
  id        String         @id @default(uuid())
  clusterId String
  cluster   ProxmoxCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  requestId String         @unique
  cpu       Int
  ramMB     Int
  diskGB    Int
  status    String         @default("PENDING") // PENDING | COMMITTED | RELEASED
  createdAt DateTime       @default(now())
  expiresAt DateTime

  @@index([clusterId, status, expiresAt])
  @@map("pending_allocations")
}

/// Timestamped health check snapshots for each microservice
model ServiceHealthLog {
  id               String   @id @default(uuid())
  serviceName      String
  status           String // UP | DEGRADED | DOWN
  responseTimeMs   Int?
  errorMessage     String?
  /// Failure classification when status != UP.
  /// TIMEOUT | NETWORK | HTTP_5XX | HTTP_4XX | MALFORMED | UNKNOWN
  failureType      String?
  uptimePercentage Float    @default(100)
  checkedAt        DateTime @default(now())

  @@index([serviceName])
  @@index([checkedAt])
  @@index([status])
  @@map("service_health_logs")
}

/// Rolled-up hourly aggregates of ServiceHealthLog. The retention job collapses
/// raw per-check rows older than 48h into one row per (service, hour).
model ServiceHealthHourlyRollup {
  id            String   @id @default(uuid())
  serviceName   String
  hourStart     DateTime
  sampleCount   Int
  upCount       Int
  degradedCount Int
  downCount     Int
  avgResponseMs Int?
  uptimePercent Float

  @@unique([serviceName, hourStart])
  @@index([hourStart])
  @@map("service_health_hourly_rollups")
}

/// Per-VPS reachability log for Prompt 6.3a tenant VPS-down alerting.
model VpsHealthLog {
  id              String          @id @default(uuid())
  vpsId           String
  cloudDeployment CloudDeployment @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  status          String // REACHABLE | UNREACHABLE
  failureType     String? // TIMEOUT | NETWORK | PROXMOX_STOPPED | UNKNOWN
  responseTimeMs  Int?
  errorMessage    String?
  checkedAt       DateTime        @default(now())

  @@index([vpsId])
  @@index([checkedAt])
  @@map("vps_health_logs")
}

