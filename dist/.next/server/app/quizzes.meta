{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/quizzes/layout,_N_T_/quizzes/page,_N_T_/quizzes"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/quizzes/__PAGE__",
    "/quizzes",
    "/_index",
    "/_head"
  ]
}