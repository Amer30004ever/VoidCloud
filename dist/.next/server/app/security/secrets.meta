{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/security/layout,_N_T_/security/secrets/layout,_N_T_/security/secrets/page,_N_T_/security/secrets"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/security/secrets/__PAGE__",
    "/security/secrets",
    "/security",
    "/_index",
    "/_head"
  ]
}