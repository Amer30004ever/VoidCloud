{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/integrations/layout,_N_T_/integrations/webhooks/layout,_N_T_/integrations/webhooks/page,_N_T_/integrations/webhooks"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/integrations/webhooks/__PAGE__",
    "/integrations/webhooks",
    "/integrations",
    "/_index",
    "/_head"
  ]
}