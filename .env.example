# ============================================
# Amer DevOps Portal - Environment Variables
# ============================================
# Copy to .env at repo root (Docker Compose loads it automatically)

NODE_ENV=development

# ============================================
# Database
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=amer_portal
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/amer_portal

# Local dev (backend on host, Postgres in Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amer_portal

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ============================================
# Application URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Must include /api/v1 — used at frontend Docker build time
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================
# Seed admin user (backend prisma db seed)
# ============================================
ADMIN_EMAIL=admin@amer.dev
ADMIN_PASSWORD=AmerDevOps2026!
ADMIN_NAME=Amer Admin

# ============================================
# Outlook SMTP (password reset & transactional email)
# Create an app password at https://account.live.com/proofs/AppPassword
# ============================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=nova-cloud-2026@outlook.com
SMTP_PASS=replace-with-app-password
EMAIL_FROM="AmerCloud <nova-cloud-2026@outlook.com>"


# ============================================
# WhatsApp Business Platform (optional)
# ============================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WEBHOOK_SECRET=

# ============================================
# GitHub (optional — or configure via Settings)
# ============================================
# GITHUB_TOKEN=
