# ============================================
# Void Cloud - Environment Variables
# ============================================
# Copy to .env at repo root (Docker Compose loads it automatically)

NODE_ENV=development

# ============================================
# Database
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=void_portal
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/void_portal

# Local dev (backend on host, Postgres in Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/void_portal

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ============================================
# Application URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Must include /api/v1 — used at frontend Docker build time
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================
# Seed admin user (backend prisma db seed)
# ============================================
ADMIN_EMAIL=admin@voidcloud.cc.cd
ADMIN_PASSWORD=VoidCloud2026!
ADMIN_NAME=Void Admin

# ============================================
# Gmail SMTP (password reset & transactional email)
# Create an app password at https://myaccount.google.com/apppasswords
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.voidcloud@gmail.com
SMTP_PASS=eyjm lege duuo xyei
EMAIL_FROM="VoidCloud <support.voidcloud@gmail.com>"

