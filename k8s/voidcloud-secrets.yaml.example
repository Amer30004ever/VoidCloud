# Copy to k8s/voidcloud-secrets.yaml (gitignored) and fill real values,
# or (preferred in CI) generate this Secret from GitHub Actions secrets via
# `kubectl create secret generic voidcloud-secrets --from-literal=... --dry-run=client -o yaml | kubectl apply -f -`.
# NEVER commit real values.
apiVersion: v1
kind: Namespace
metadata:
  name: voidcloud
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: voidcloud
type: Opaque
stringData:
  POSTGRES_USER: REPLACE_ME
  POSTGRES_PASSWORD: REPLACE_ME
  POSTGRES_DB: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: voidcloud-app-secret
  namespace: voidcloud
type: Opaque
stringData:
  DATABASE_URL: postgresql://REPLACE_ME:REPLACE_ME@postgres.voidcloud.svc.cluster.local:5432/REPLACE_ME
  JWT_SECRET: REPLACE_ME_MIN_32_RANDOM_BYTES_BASE64
  JWT_EXPIRES_IN: "7d"
  SMTP_HOST: smtp.example.com
  SMTP_PORT: "587"
  SMTP_USER: REPLACE_ME
  SMTP_PASS: REPLACE_ME
  EMAIL_FROM: "VoidCloud <no-reply@example.com>"
  PROXMOX_HOST: REPLACE_ME
  PROXMOX_TOKEN_ID: REPLACE_ME
  PROXMOX_TOKEN_SECRET: REPLACE_ME
  PROXMOX_NODE: REPLACE_ME
  PROXMOX_STORAGE: REPLACE_ME
  PROXMOX_BRIDGE: REPLACE_ME
  PROXMOX_IP_POOL_CIDR: REPLACE_ME
  PROXMOX_GATEWAY: REPLACE_ME
  # Required by seed job when explicitly opted-in
  SEED_ADMIN_EMAIL: REPLACE_ME
  SEED_ADMIN_PASSWORD: REPLACE_ME
  SEED_ENABLED: "false"
