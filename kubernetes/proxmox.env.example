# Copy to proxmox.env and fill in real values.
# proxmox.env is gitignored — never commit secrets.

NAMESPACE=voidcloud

# Database (must match postgres deployment)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/voidcloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voidcloud
JWT_SECRET=change-me-to-a-long-random-string

# Proxmox VE API (token name contains "!" — always use single quotes in shell)
PROXMOX_HOST=https://10.51.100.10:8006
PROXMOX_TOKEN_ID=root@pam!Amer-Cloud
PROXMOX_TOKEN_SECRET=your-token-secret-uuid
PROXMOX_NODE=proxmox
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_GATEWAY=10.51.100.1
PROXMOX_IP_POOL_CIDR=10.51.100.0/24
# Tenant VM network isolation (Prompt 0.15):
#   PROXMOX_K8S_INTERNAL_CIDRS — comma-separated CIDRs tenant VMs must NEVER reach
#     (the Kubernetes internal network hosting Postgres/Redis/RabbitMQ + the 13
#     microservices). Defaults to common K8s pod/service CIDRs if unset.
#     OVERRIDE this to match your real cluster CIDRs.
#   PROXMOX_VLAN_PER_TENANT — "true" to tag each tenant VM with a deterministic
#     802.1Q VLAN (defence-in-depth; requires the bridge/switch to carry VLANs).
#     The per-VM firewall below is ALWAYS applied regardless of this setting.
PROXMOX_K8S_INTERNAL_CIDRS=10.42.0.0/16,10.43.0.0/16,10.244.0.0/16,10.96.0.0/12,172.16.0.0/12
PROXMOX_VLAN_PER_TENANT=false
PROXMOX_TEMPLATE=local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst

# Admin seed (used by voidcloud-setup-backend.sh)
# Optional: MIP-WA-CRM URLs after deploying ../MIP-WA-CRM on a VPS
# WA_CRM_FRONTEND_URL=http://crm.yourdomain.com
# WA_CRM_API_URL=http://crm.yourdomain.com/api/v1
ADMIN_EMAIL=amer30004ever@hotmail.com
ADMIN_PASSWORD=Admin123

# VPS API smoke test (voidcloud-vps-api-test.sh)
VPS_TEST_NAME=test-vps-kubectl
VPS_TEST_SOURCE=Ubuntu 22.04
