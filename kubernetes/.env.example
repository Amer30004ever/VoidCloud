# Docker Hub Configuration
# Copy this file to dockerhub.env and fill in your credentials
# WARNING: Never commit dockerhub.env to git!

# Required: Your Docker Hub username
DOCKER_HUB_USERNAME=amer30004ever

# Required: Docker Hub access token or password
# Recommended: Use access token from https://hub.docker.com/settings/security
DOCKER_HUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Repository name prefix (default: voidcloud)
DOCKER_HUB_REPO=voidcloud

# Optional: Image tags (default: latest)
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Domain Configuration
DOMAIN=amer.homelab.com
API_DOMAIN=api.amer.homelab.com

# Kubernetes Configuration
NAMESPACE=voidcloud