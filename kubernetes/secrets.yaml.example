apiVersion: v1
kind: Secret
metadata:
  name: voidcloud-secrets
  namespace: voidcloud
type: Opaque
stringData:
  # Database connection string
  DATABASE_URL: "postgresql://voidcloud_user:your_password_here@postgres:5432/voidcloud_db"
  
  # JWT secret for authentication
  JWT_SECRET: "your_jwt_secret_here_change_this_in_production"
  
  # SMTP configuration for email
  SMTP_HOST: "smtp.example.com"
  SMTP_PORT: "587"
  SMTP_USER: "your_smtp_user"
  SMTP_PASS: "your_smtp_password"
  EMAIL_FROM: "noreply@voidcloud.cc.cd"
  
  # PostgreSQL credentials (for postgres deployment)
  POSTGRES_USER: "voidcloud_user"
  POSTGRES_PASSWORD: "your_password_here"
  POSTGRES_DB: "voidcloud_db"
  
  # Redis configuration
  REDIS_PASSWORD: "your_redis_password"
  
  # RabbitMQ configuration
  RABBITMQ_USER: "voidcloud_user"
  RABBITMQ_PASSWORD: "your_rabbitmq_password"
