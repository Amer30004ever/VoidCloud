{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amer DevOps Portal",
  "version": "0.1.0",
  "identifier": "cc.cd.voidcloud.portal",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://voidcloud.cc.cd https://*.voidcloud.cc.cd http://localhost:3000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Void Cloud DevOps portal",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
