{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "lib/*"
  ],
  "scripts": {
    "dev": "cd frontend && PORT=8080 bun run dev -- -p 8080 -H 0.0.0.0",
    "build": "cd frontend && bun run build",
    "build:dev": "cd frontend && bun run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build",
    "test": "cd tests && npm test",
    "test:jest": "cd tests && npm run test:jest",
    "test:node": "cd tests && npm run test:node"
  },
  "private": true,
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^5",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3",
    "vite": "^7"
  },
  "dependencies": {}
}
