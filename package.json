{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "lib/*"
  ],
  "scripts": {
    "dev": "cd frontend && PORT=8080 bun run dev -- -p 8080 -H 0.0.0.0",
    "build": "cd frontend && bun run build && cd .. && node scripts/assemble-dist.mjs",
    "build:dev": "cd frontend && bun run build && cd .. && node scripts/assemble-dist.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build",
    "test": "cd tests && npm test",
    "test:jest": "cd tests && npm run test:jest",
    "test:node": "cd tests && npm run test:node",
    "verify:oidc": "tsx scripts/verify-oidc-roundtrip.ts",
    "postinstall": "node scripts/link-next.mjs",
    "link:next": "node scripts/link-next.mjs",
    "verify:next": "node scripts/link-next.mjs --check"
  },
  "private": true,
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^5",
    "prettier": "^3.8.4",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "vite": "^7"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.28",
      "@nestjs/core": "11.1.28",
      "class-validator": "0.14.4"
    }
  }
}
